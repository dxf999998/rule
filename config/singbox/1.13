{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "dns": {
    "servers": [
      {
        "tag": "local",
        "type": "udp",
        "server": "222.172.200.68"
      },
      {
        "tag": "public",
        "type": "https",
        "server": "dns.alidns.com",
        "domain_resolver": "local"
      },
      {
        "tag": "foreign",
        "type": "https",
        "server": "1.1.1.1",
        "detour": "默认代理"
      }
    ],
    "rules": [
      {
        "clash_mode": "direct",
        "server": "local"
      },
      {
        "clash_mode": "global",
        "server": "foreign"
      },
      {
        "domain_suffix": [
          "services.googleapis.cn",
          "googleapis.cn",
          "xn--ngstr-lra8j.com"
        ],
        "server": "foreign"
      },
      {
        "rule_set": "geosite-google",
        "server": "foreign"
      },
      {
        "rule_set": "geosite-ai",
        "server": "foreign"
      },
      {
        "rule_set": "geosite-youtube",
        "server": "foreign"
      },
      {
        "rule_set": "geosite-github",
        "server": "foreign"
      },
      {
        "rule_set": "geosite-telegram",
        "server": "foreign"
      },
      {
        "rule_set": "geosite-tiktok",
        "server": "foreign"
      },
      {
        "rule_set": "geosite-netflix",
        "server": "foreign"
      },
      {
        "rule_set": "geosite-cn",
        "server": "local"
      },
      {
        "rule_set": "geosite-apple",
        "server": "local"
      },
      {
        "rule_set": "geosite-private",
        "server": "local"
      }
    ],
    "final": "foreign",
    "strategy": "ipv4_only",
    "cache_capacity": 4096,
    "optimistic": {
      "enabled": true,
      "timeout": "3d"
    },
    "timeout": "5s",
    "reverse_mapping": true
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "interface_name": "tun0",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "mtu": 1500,
      "auto_route": true,
      "auto_redirect": true,
      "strict_route": true,
      "stack": "system",
      "route_exclude_address": [
        "10.0.0.0/24",
        "172.19.0.0/30",
        "127.0.0.0/8",
        "224.0.0.0/4",
        "255.255.255.255/32"
      ]
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "0.0.0.0",
      "listen_port": 20122
    },
    {
      "type": "redirect",
      "tag": "redirect-in",
      "listen": "0.0.0.0",
      "listen_port": 7892
    }
  ],
  "outbounds": [
    {
      "tag": "默认代理",
      "type": "selector",
      "outbounds": [
        "日本自动",
        "狮城自动",
        "香港自动",
        "美国自动",
        "手动选择",
        "自动选择"
      ],
      "interrupt_exist_connections": true
    },
    {
      "tag": "AI",
      "type": "selector",
      "outbounds": [
        "日本自动",
