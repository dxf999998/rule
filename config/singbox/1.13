        "outbound": "Steam"
      },
      {
        "rule_set": "geosite-!cn",
        "outbound": "默认代理"
      },
      {
        "action": "resolve"
      },
      {
        "rule_set": "geoip-google",
        "outbound": "Google"
      },
      {
        "rule_set": "geoip-apple",
