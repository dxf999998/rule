        "美国自动",
        "手动选择",
        "自动选择",
        "直连"
      ],
      "interrupt_exist_connections": true
    },
    {
      "tag": "漏网之鱼",
      "type": "selector",
      "outbounds": [
        "默认代理",
        "日本自动",
        "狮城自动",
        "香港自动",
        "美国自动",
        "手动选择",
        "自动选择",
        "直连"
      ],
      "interrupt_exist_connections": true
    },
    {
      "tag": "日本自动",
      "type": "urltest",
      "outbounds": [
        "{all}"
      ],
      "filter": [
        {
          "action": "include",
          "keywords": [
            "🇯🇵",
            "JP",
            "jp",
            "日本",
            "日",
            "Japan"
          ]
        },
        {
          "action": "exclude",
          "keywords": [
            "免费"
          ]
        }
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "5m",
      "tolerance": 30,
      "idle_timeout": "10m",
      "interrupt_exist_connections": false
    },
    {
      "tag": "狮城自动",
      "type": "urltest",
      "outbounds": [
        "{all}"
      ],
      "filter": [
        {
          "action": "include",
          "keywords": [
            "🇸🇬",
            "SG",
            "sg",
            "新加坡",
            "狮城",
            "Singapore"
          ]
        },
        {
          "action": "exclude",
          "keywords": [
            "免费"
          ]
        }
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "5m",
      "tolerance": 30,
      "idle_timeout": "10m",
      "interrupt_exist_connections": false
    },
    {
      "tag": "香港自动",
      "type": "urltest",
      "outbounds": [
        "{all}"
      ],
      "filter": [
        {
          "action": "include",
          "keywords": [
            "🇭🇰",
            "HK",
            "hk",
            "香港",
            "港",
            "HongKong"
          ]
        },
        {
          "action": "exclude",
          "keywords": [
            "免费"
          ]
        }
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "5m",
      "tolerance": 30,
      "idle_timeout": "10m",
      "interrupt_exist_connections": false
    },
    {
      "tag": "美国自动",
      "type": "urltest",
      "outbounds": [
        "{all}"
      ],
      "filter": [
        {
          "action": "include",
          "keywords": [
            "🇺🇸",
            "US",
            "us",
            "美国",
            "美",
            "United States"
          ]
        },
        {
          "action": "exclude",
          "keywords": [
            "AUS",
            "RUS",
            "免费"
          ]
        }
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "5m",
      "tolerance": 30,
      "idle_timeout": "10m",
      "interrupt_exist_connections": false
    },
    {
      "tag": "手动选择",
      "type": "selector",
      "outbounds": [
        "{all}"
      ],
      "filter": [
        {
          "action": "exclude",
          "keywords": [
            "官网",
            "到期时间",
            "剩余",
            "流量",
            "套餐",
            "免费",
            "订阅",
            "全球直连",
            "GB",
            "Expire Date",
            "Traffic",
            "ExpireDate"
          ]
        }
      ],
      "interrupt_exist_connections": true
    },
    {
      "tag": "自动选择",
      "type": "urltest",
      "outbounds": [
        "{all}"
      ],
      "filter": [
        {
          "action": "exclude",
          "keywords": [
            "官网",
            "到期时间",
            "剩余",
            "流量",
            "套餐",
            "免费",
            "订阅",
            "全球直连",
            "GB",
            "Expire Date",
            "Traffic",
            "ExpireDate"
          ]
        }
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "5m",
      "tolerance": 30,
      "idle_timeout": "10m",
      "interrupt_exist_connections": false
    },
    {
      "tag": "GLOBAL",
      "type": "selector",
      "outbounds": [
        "默认代理",
        "AI",
        "X",
        "YouTube",
        "Google",
        "Github",
        "Telegram",
        "TikTok",
        "Netflix",
        "PayPal",
        "Steam",
        "Microsoft",
        "OneDrive",
        "Apple",
        "漏网之鱼",
        "日本自动",
        "狮城自动",
        "香港自动",
        "美国自动",
        "手动选择",
        "自动选择",
        "直连"
      ],
      "interrupt_exist_connections": true
    },
    {
      "tag": "直连",
      "type": "direct",
      "domain_resolver": "public"
    }
